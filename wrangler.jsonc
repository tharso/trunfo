{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-trunfo-ciclismo",
  "compatibility_date": "2026-11-01",
  // Subdomínio próprio. Exige a zona tharso.com na mesma conta Cloudflare;
  // a Cloudflare cria o DNS e o certificado HTTPS no deploy.
  "routes": [
    { "pattern": "supertrunfo.tharso.com", "custom_domain": true }
  ],
  // Segunda versão (multiplayer): o Worker do site também tem o Durable Object
  // das salas. Só /sala/* passa pelo Worker; o resto são os arquivos estáticos,
  // em modo SPA, como na primeira versão.
  "main": "src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sala/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALA", "class_name": "Sala" }]
  },
  // DO com SQLite (o que o plano grátis aceita).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }]
}
