    "icones": "pwa-assets-generator"
  },
  "dependencies": {
    "partysocket": "1.3.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
